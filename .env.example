# Postgres — Neon, Vercel Postgres, or local Docker / Homebrew
# Local Docker: postgresql://portal:portal@127.0.0.1:5432/portal
DATABASE_URL=postgresql://portal:portal@127.0.0.1:5432/portal

# Sign session cookies. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Billy-only admin gate for /admin
ADMIN_PASSWORD=atmos-admin

# Demo + first NAS client login (used only when those users are created)
DEMO_PASSWORD=portal1234

# UGOS share-download (server-side proxy). The short ug.link URL redirects to the NAS host.
# Example share (no password today):
#   https://ug.link/10128873/filemgr/share-download/?id=2b5682e6af0a419393595b283f58d88d
#   → https://10128873.us15.ug.link/filemgr/share-download/?id=2b5682e6af0a419393595b283f58d88d
NAS_ENABLED=false
NAS_SHARE_HOST=https://10128873.us15.ug.link
NAS_SHARE_ID=2b5682e6af0a419393595b283f58d88d
NAS_SHARE_PASSWORD=
NAS_SHARE_URL=
NAS_STILLS_FOLDERS=Final,Photos
NAS_CACHE_DIR=.nas-cache

# Absolute origin used in public shoot URLs (webhook payload + admin).
PORTAL_PUBLIC_URL=http://127.0.0.1:43173

# Optional Pepper / automation hook. POST JSON on shoot.ready and shoot.delivered.
# Leave empty to skip. The portal does not send delivery email itself.
DELIVERY_WEBHOOK_URL=

# Optional. When set, password reset emails are sent through Resend.
# Without it, the reset link is shown on the forgot-password screen.
RESEND_API_KEY=
EMAIL_FROM=Billy Kyle Client Portal <noreply@example.com>
