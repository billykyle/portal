# Postgres — Neon, Vercel Postgres, or local Docker / Homebrew
# Local Docker: postgresql://portal:portal@127.0.0.1:5432/portal
# Production (Vercel): postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://portal:portal@127.0.0.1:5432/portal

# Sign session cookies. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Billy-only admin gate for /admin
ADMIN_PASSWORD=atmos-admin

# Demo + first NAS client login (used only when those users are created)
DEMO_PASSWORD=portal1234

# Vercel Cron → GET /api/cron/nas-sync. Required in production or the route 401s.
# Vercel sends Authorization: Bearer $CRON_SECRET. Generate a long random string.
CRON_SECRET=

# UGOS share-download (server-side proxy). The short ug.link URL redirects to the NAS host.
# Example share (no password today):
#   https://ug.link/10128873/filemgr/share-download/?id=2b5682e6af0a419393595b283f58d88d
#   → https://10128873.us15.ug.link/filemgr/share-download/?id=2b5682e6af0a419393595b283f58d88d
NAS_ENABLED=true
NAS_SHARE_HOST=https://10128873.us15.ug.link
NAS_SHARE_ID=2b5682e6af0a419393595b283f58d88d
NAS_SHARE_PASSWORD=
NAS_SHARE_URL=
NAS_STILLS_FOLDERS=Final,Photos
NAS_CACHE_DIR=.nas-cache
# On Vercel the default is /tmp/nas-cache (ephemeral). You can set it explicitly:
# NAS_CACHE_DIR=/tmp/nas-cache

# In-process auto-sync while next dev / next start is running. Default 10.
# Set to 0 or NAS_SYNC_ENABLED=false to disable. Admin / npm run nas:sync still work.
# On Vercel the in-process timer is off; production uses vercel.json cron every 10 min.
NAS_SYNC_INTERVAL_MINUTES=10
NAS_SYNC_ENABLED=true

# Absolute origin used in public shoot URLs (webhook payload + admin).
# Local:
PORTAL_PUBLIC_URL=http://127.0.0.1:43173
# Production:
# PORTAL_PUBLIC_URL=https://portal.billy-kyle.com

# Optional Pepper / automation hook. POST JSON on shoot.ready and shoot.delivered.
# Leave empty to skip. The portal does not send delivery email itself.
DELIVERY_WEBHOOK_URL=

# Optional. When set, password-reset and booking-confirmation emails go through Resend.
# Without it, the reset link is shown on the forgot-password screen, and Book shoot
# still succeeds (no mail). Delivery photos still use DELIVERY_WEBHOOK_URL / Pepper.
RESEND_API_KEY=
EMAIL_FROM=Billy Kyle <billy@billyhere.com>
# Optional. Second Resend send (Billy's booking alert). Defaults to billy@billyhere.com.
# Not CC/BCC — a separate email after Book shoot.
BOOKING_NOTIFY_EMAIL=billy@billyhere.com

# Client scheduling (Acuity replacement). Calendar is source of truth when set.
# Leave empty to use portal bookings only — never invents drive times.
#
# Locked availability calendars (A+B). A slot is busy if EITHER is busy.
# Do not include US Holidays.
#   Work:     billy@atmosimagery.com
#   Personal: bkyle015@gmail.com
# Share both with the service-account email. Bookings write to the first ID.
GOOGLE_CALENDAR_IDS=billy@atmosimagery.com,bkyle015@gmail.com
# Backward-compatible single-id fallback (used only when GOOGLE_CALENDAR_IDS is empty):
# GOOGLE_CALENDAR_ID=billy@atmosimagery.com
#
# Production (Vercel): OIDC + GCP Workload Identity Federation.
# Impersonates portal-scheduling — no downloadable SA JSON key.
# Flynn creates the WIF pool/provider in GCP; paste the IDs here.
# See docs/google-calendar.md and https://vercel.com/docs/oidc/gcp
GCP_PROJECT_ID=glassy-polymer-509203-r1
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=portal-scheduling@glassy-polymer-509203-r1.iam.gserviceaccount.com
# Alias accepted: GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Optional. Leave empty: the app uses the default Team-issuer token
# (aud https://vercel.com/billy-kyle) which matches GCP Allowed audiences.
# Set this to the IAM provider https URL only if the WIF provider uses
# GCP “Default audience”.
# GCP_AUDIENCE=
#
# Local/dev fallback only (org policy blocks new SA keys on this GCP project):
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# One server-only key for Distance Matrix (travel) + Places Autocomplete /
# Place Details (suggestions) + Address Validation (format a typed address).
# In Google Cloud enable: Places API (New) or Places API, Address Validation,
# and Distance Matrix. Restrict the key to those APIs. Empty = no invented
# suggestions or drive times — the book form shows a clear message instead.
GOOGLE_MAPS_API_KEY=
# Optional working-hours overrides (defaults: America/New_York, 8–18, 90-min slots)
# SCHEDULING_TIMEZONE=America/New_York
# SCHEDULING_OPEN_HOUR=8
# SCHEDULING_CLOSE_HOUR=18
# SCHEDULING_SLOT_MINUTES=90
# SCHEDULING_SLOT_STEP_MINUTES=30
# SCHEDULING_DAYS_AHEAD=14
# Bookable horizon is at least 3 months from today (week view still shows 7 days).
# SCHEDULING_MIN_LEAD_MINUTES=120
