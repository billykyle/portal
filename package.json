    "nas:sync:warm": "tsx --env-file=.env.local scripts/sync-nas.ts --warm",
    "test:nas": "tsx --test src/lib/nas-folder.test.ts src/lib/delivery.test.ts src/lib/nas-sync-config.test.ts src/lib/runtime.test.ts src/lib/welcome.test.ts src/lib/demo-shoots.test.ts src/lib/download-all.test.ts src/lib/download-scope.test.ts src/lib/shoot-zip.test.ts src/lib/zip-jobs.test.ts src/lib/nas-auth.test.ts src/lib/thumb-retry.test.ts src/lib/photo-viewer.test.ts src/lib/site-metadata.test.ts src/lib/shoot-search.test.ts"
  },
